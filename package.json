{
  "name": "lmnas-turbo-v2",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@lmnas/site --filter=@lmnas/docs --filter=@lmnas/blogs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "preflight": "node scripts/doctor.mjs",
    "dev:full": "turbo run dev --parallel"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.11.1",
    "eslint-config-next": "15.0.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
