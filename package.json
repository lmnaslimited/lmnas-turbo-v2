{
  "name": "lmnas-turbo-v2",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev typecheck --filter=@lmnas/site --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "contracts:gen": "pnpm --filter @lmnas/contracts-sync run gen",
    "contracts:check": "pnpm --filter @lmnas/contracts-sync run check"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.24.1",
    "@types/node": "^24.0.0",
    "eslint": "^8.57.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
