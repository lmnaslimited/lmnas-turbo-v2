{
  "name": "lmnas-turbo-v2",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20 <=22"
  },
  "volta": {
    "node": "22.11.0"
  },
  "scripts": {
    "dev": "turbo run dev typecheck --filter=@lmnas/site --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "content:schema": "pnpm --filter @lmnas/content-importer run schema",
    "content:schema:facts": "pnpm --filter @lmnas/content-importer run schema:facts",
    "content:plan": "pnpm --filter @lmnas/content-importer run plan",
    "content:fidelity": "pnpm --filter @lmnas/content-importer run fidelity",
    "content:validate-plan": "pnpm --filter @lmnas/content-importer run validate-plan",
    "content:apply": "pnpm --filter @lmnas/content-importer run apply",
    "content:onboard": "pnpm --filter @lmnas/content-importer run onboard",
    "contracts:gen": "pnpm --filter @lmnas/contracts-sync run gen",
    "contracts:check": "pnpm --filter @lmnas/contracts-sync run check",
    "phase0:guard": "node tools/phase0/guard.mjs",
    "phase0:new": "node tools/phase0/new.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.24.1",
    "@types/node": "^24.0.0",
    "eslint": "^8.57.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
