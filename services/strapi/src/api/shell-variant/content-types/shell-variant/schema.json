{
  "kind": "collectionType",
  "collectionName": "shell_variants",
  "info": {
    "singularName": "shell-variant",
    "pluralName": "shell-variants",
    "displayName": "Shell Variant"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "variantKey": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "role": {
      "type": "enumeration",
      "enum": ["navbar", "footer", "full"],
      "required": true,
      "default": "full"
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "inactive"],
      "required": true,
      "default": "inactive"
    },
    "actions": {
      "type": "json",
      "required": false
    },
    "shell": {
      "type": "component",
      "repeatable": false,
      "component": "shell.shell-variant",
      "required": true
    }
  }
}
