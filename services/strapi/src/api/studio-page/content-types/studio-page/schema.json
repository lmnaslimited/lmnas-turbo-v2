{
  "kind": "collectionType",
  "collectionName": "studio_pages",
  "info": {
    "singularName": "studio-page",
    "pluralName": "studio-pages",
    "displayName": "Studio Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "pageKey": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "locale": {
      "type": "string",
      "required": true,
      "default": "en"
    },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "published"],
      "required": true,
      "default": "draft"
    },
    "lifecycle": {
      "type": "enumeration",
      "enum": ["draft", "published", "archived"],
      "required": true,
      "default": "draft"
    },
    "activeShellId": {
      "type": "string"
    },
    "shellKey": {
      "type": "string"
    },
    "blockOrder": {
      "type": "json"
    },
    "fieldValues": {
      "type": "json"
    },
    "actionOverrides": {
      "type": "json"
    },
    "productMapping": {
      "type": "string"
    },
    "industryMapping": {
      "type": "json"
    },
    "primaryCta": {
      "type": "json"
    },
    "conversionConfig": {
      "type": "json"
    },
    "campaignUtmStrategy": {
      "type": "json"
    },
    "taxonomyState": {
      "type": "json"
    },
    "seoMetadata": {
      "type": "json"
    },
    "seoJsonLdValid": {
      "type": "boolean",
      "default": false
    },
    "blockSchemaValid": {
      "type": "boolean",
      "default": true
    },
    "previewValid": {
      "type": "boolean",
      "default": false
    },
    "previewHtml": {
      "type": "text"
    }
  }
}
