{
  "kind": "collectionType",
  "collectionName": "studio_blocks",
  "info": {
    "singularName": "studio-block",
    "pluralName": "studio-blocks",
    "displayName": "Studio Block"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "blockKey": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "blockType": {
      "type": "string",
      "required": true,
      "default": "imported_dom_snapshot"
    },
    "family": {
      "type": "string",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "inactive", "draft"],
      "required": true,
      "default": "active"
    },
    "lifecycle": {
      "type": "enumeration",
      "enum": ["draft", "published", "archived"],
      "required": true,
      "default": "draft"
    },
    "scope": {
      "type": "enumeration",
      "enum": ["global", "page-local"],
      "required": true,
      "default": "global"
    },
    "schemaStatus": {
      "type": "enumeration",
      "enum": ["valid", "invalid", "warning"],
      "required": true,
      "default": "valid"
    },
    "themeKey": {
      "type": "string",
      "required": true,
      "default": "default"
    },
    "sourceType": {
      "type": "string"
    },
    "sourceRef": {
      "type": "string"
    },
    "domJson": {
      "type": "json"
    },
    "classMap": {
      "type": "json"
    },
    "stylesheetRef": {
      "type": "string"
    },
    "themeMapping": {
      "type": "json"
    },
    "fidelityMetadata": {
      "type": "json"
    },
    "sourcePreviewHtml": {
      "type": "text",
      "description": "Disposable comparison preview cache. Never canonical block content."
    },
    "targetPreviewHtml": {
      "type": "text",
      "description": "Disposable target preview cache. Regenerated from canonical block snapshot plus theme."
    },
    "sourceAssetContext": {
      "type": "json"
    },
    "importProposalId": {
      "type": "string"
    },
    "importMaster": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::studio-import-master.studio-import-master"
    },
    "confidence": {
      "type": "decimal"
    },
    "editableFields": {
      "type": "json"
    },
    "actions": {
      "type": "json"
    },
    "previewHtml": {
      "type": "text",
      "description": "Disposable preview cache. Canonical rendering comes from domJson/classMap/stylesheetRef."
    },
    "usageCount": {
      "type": "integer",
      "default": 0
    },
    "productMapping": {
      "type": "string"
    },
    "industryMapping": {
      "type": "json"
    }
  }
}
