{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Block-based page"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "pageType": {
      "type": "enumeration",
      "enum": ["home", "product", "solution", "industry", "simple"],
      "required": true
    },
    "layoutKey": {
      "type": "enumeration",
      "enum": ["homeLayout", "productLayout", "solutionLayout", "industryLayout", "simpleLayout"],
      "required": true
    },
    "conversionConfig": {
      "type": "component",
      "repeatable": false,
      "component": "shared.conversion-config",
      "required": true
    },
    "blocks": {
      "type": "dynamiczone",
      "components": ["blocks.hero", "blocks.faq", "blocks.imported-dom-snapshot"],
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true
    }
  }
}
