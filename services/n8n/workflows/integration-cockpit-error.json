        "functionCode": "const payload = $json || {};\nconst execution = payload.execution || {};\nconst workflow = payload.workflow || {};\nconst err = payload.error || {};\n\nconst executionId = execution.id\n  ? `n8n-${execution.id}`\n  : ((globalThis.crypto && globalThis.crypto.randomUUID)\n    ? globalThis.crypto.randomUUID()\n    : 'err-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10));\n\nconst startedAt = execution.startedAt || new Date().toISOString();\nconst endedAt = new Date().toISOString();\nconst failedStep = execution.lastNodeExecuted || err.node?.name || 'unknown';\nconst errorMessage = err.message || 'Unhandled n8n workflow error';\n\nconst log = {\n  execution_id: executionId,\n  doctype: 'UNKNOWN',\n  mode: 'LIVE',\n  status: 'FAILED',\n  start_time: startedAt,\n  end_time: endedAt,\n  steps: [\n    { step: 'error_trigger', status: 'FAILED', time: endedAt },\n    { step: failedStep, status: 'FAILED', time: endedAt }\n  ],\n  error: errorMessage,\n  failed_step: failedStep,\n  payload_snapshot: {\n    workflow: {\n      id: workflow.id || null,\n      name: workflow.name || null\n    },\n    execution,\n    error: err\n  }\n};\n\nconst response = {\n  execution_id: executionId,\n  status: 'FAILED',\n  error: errorMessage,\n  failed_step: failedStep\n};\n\nreturn [{ json: { ...payload, execution_id: executionId, log, response } }];"
