      },
      "id": "8d65e5e6-ef9e-42bc-923b-fa7ea7722ab7",
      "name": "Transaction Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -520,
        120
      ]
    },
    {
      "parameters": {
        "functionCode": "const lookup = $json || {};\nconst request = $node['Validate Replay Request'].json;\nconst tx = lookup.transaction || {};\n\nconst originalRequest = tx.original_request\n  || tx.payload_snapshot?.original_request\n  || tx.transaction?.payload_snapshot?.original_request\n  || tx.raw?.original_request\n  || tx.raw?.payload_snapshot?.original_request\n  || null;\n\nif (!originalRequest) {\n  return [{\n    json: {\n      payload_ready: false,\n      status: 'FAILED',\n      error: 'No original request payload found for execution_id',\n      failed_step: 'build_replay_payload',\n      source_execution_id: request.execution_id\n    }\n  }];\n}\n\nconst replayPayload = { ...originalRequest };\n\nif (request.force_live) {\n  replayPayload.simulation = false;\n}\n\nif (request.simulation_override !== null) {\n  replayPayload.simulation = request.simulation_override;\n}\n\nreturn [{\n  json: {\n    payload_ready: true,\n    source_execution_id: request.execution_id,\n    replay_payload: replayPayload\n  }\n}];"
      },
      "id": "5f08e831-d0cb-4f5f-954f-d3db61f625f8",
      "name": "Build Replay Payload",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -300,
        20
      ]
    },
    {
      "parameters": {
