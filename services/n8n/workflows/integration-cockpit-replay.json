        "url": "http://127.0.0.1:5678/webhook/cockpit-lookup",
        "jsonParameters": true,
        "bodyParametersJson": "={{ { \"execution_id\": $node[\"Validate Replay Request\"].json.execution_id } }}",
        "options": {}
      },
      "id": "ce5b7932-8cf3-41eb-beb3-95b8f8c7702b",
      "name": "Fetch Transaction for Replay",
