    {
      "parameters": {
        "functionCode": "const executionId = $json.execution_id;\nconst forceLive = $json.force_live === true;\nconst simulationOverride = typeof $json.simulation === 'boolean' ? $json.simulation : null;\n\nconst response = {\n  request_valid: Boolean(executionId),\n  execution_id: executionId || null,\n  force_live: forceLive,\n  simulation_override: simulationOverride\n};\n\nif (!response.request_valid) {\n  response.error = 'execution_id is required';\n}\n\nreturn [{ json: response }];"
      },
      "id": "3b17f85b-5f33-4721-ba87-d6c25af8ed93",
      "name": "Validate Replay Request",
      "type": "n8n-nodes-base.function",
