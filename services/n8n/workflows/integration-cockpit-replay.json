      "position": [
        -1180,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.request_valid}}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "95dd6deb-f66f-4f54-84a9-1736d9698d0f",
      "name": "Replay Request Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -960,
        200
      ]
    },
    {
      "parameters": {
        "functionCode": "return [{\n  json: {\n    status: 'FAILED',\n    error: 'execution_id is required for replay',\n    failed_step: 'replay_request_validation'\n  }\n}];"
      },
