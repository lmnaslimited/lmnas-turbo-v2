    {
      "parameters": {
        "functionCode": "const sourceExecutionId = $node['Build Replay Payload'].json.source_execution_id;\nconst replayResult = $json;\n\nreturn [{\n  json: {\n    status: replayResult.error ? 'FAILED' : 'REPLAY_TRIGGERED',\n    source_execution_id: sourceExecutionId,\n    replay_result: replayResult\n  }\n}];"
      },
